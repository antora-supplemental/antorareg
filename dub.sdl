name "antorareg"
description "Manage the UI bundle and extensions an Antora 3 playbook pulls in, checked against the Antora Extensions Registry."
authors "Ryan Johnson"
copyright "Copyright © 2026, antora-supplemental"
license "MIT"
homepage "https://github.com/antora-supplemental/antorareg"
dependency "yaml-edit" path="../../dlang-supplemental/yaml-edit-d"
targetPath "bin"

configuration "application" {
	targetType "executable"
	mainSourceFile "source/app.d"
}

configuration "unittest" {
	targetName "antorareg-test-runner"
	targetType "executable"
	stringImportPaths "tests/fixtures"
	excludedSourceFiles "source/app.d"
	mainSourceFile "tests/runner.d"
	sourcePaths "source" "tests"
}
